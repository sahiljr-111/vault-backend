# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vaultapp

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT secrets. No fallback defaults exist; boot fails if these are missing.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8081

# SMTP for emailing ENCRYPTED backup blobs (optional; export still works without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
