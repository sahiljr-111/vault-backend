# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vaultapp

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT secrets. No fallback defaults exist; boot fails if these are missing.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8081

# Email delivery.
#
# Prefer the HTTPS API: many hosts (Render's free tier included) block outbound
# SMTP ports 25/465/587 outright, and a blocked port hangs rather than failing,
# so nothing is sent and nothing is logged. Set these and SMTP is not used.
MAIL_PROVIDER=          # brevo | resend
MAIL_API_KEY=
MAIL_FROM=              # the verified sender address

# SMTP — used only when MAIL_API_KEY is unset. Fine for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
